diff --git a/resources/css/components/sections/how-we-work.scss b/resources/css/components/sections/how-we-work.scss
index 5d251f6..d1827f7 100644
--- a/resources/css/components/sections/how-we-work.scss
+++ b/resources/css/components/sections/how-we-work.scss
@@ -208,6 +208,85 @@
     left: calc((var(--step-col) + var(--step-gap)) + (var(--step-col) / 2) + 1px);
   }
 
+  .how-we-work-fx {
+    display: block;
+    width: calc(var(--step-col) + var(--step-gap));
+    height: var(--flow-offset-top);
+    max-width: none;
+    box-sizing: border-box;
+    border: 1px solid #4e4e4e;
+    border-bottom: 0;
+    border-radius: 8px 8px 0 0;
+    opacity: 1;
+    overflow: visible;
+  }
+
+  .how-we-work-fx img {
+    display: none;
+  }
+
+  .how-we-work-fx::before,
+  .how-we-work-fx::after {
+    content: "";
+    position: absolute;
+    display: block;
+    pointer-events: none;
+    z-index: 5;
+  }
+
+  .how-we-work-fx::before {
+    left: -3px;
+    bottom: -3px;
+    width: 6px;
+    height: 6px;
+    border-radius: 50%;
+    background: #4e4e4e;
+  }
+
+  .how-we-work-fx::after {
+    right: -4px;
+    bottom: 0;
+    width: 8px;
+    height: 7px;
+    background: #4e4e4e;
+    clip-path: polygon(50% 100%, 0 0, 100% 0);
+  }
+
+  .how-we-work-fx:nth-child(1) {
+    top: 0;
+    left: calc(var(--step-col) / 2);
+  }
+
+  .how-we-work-fx:nth-child(2) {
+    top: 0;
+    left: calc((2 * (var(--step-col) + var(--step-gap))) + (var(--step-col) / 2));
+  }
+
+  .how-we-work-fx:nth-child(3) {
+    top: calc(var(--flow-offset-top) + var(--step-card-height));
+    left: calc((var(--step-col) + var(--step-gap)) + (var(--step-col) / 2));
+    height: 24px;
+    border-top: 0;
+    border-bottom: 1px solid #4e4e4e;
+    border-radius: 0 0 8px 8px;
+  }
+
+  .how-we-work-fx:nth-child(3)::before {
+    left: -3px;
+    top: -3px;
+    bottom: auto;
+  }
+
+  .how-we-work-fx:nth-child(3)::after {
+    right: -4px;
+    top: 0;
+    bottom: auto;
+    width: 8px;
+    height: 7px;
+    background: #4e4e4e;
+    clip-path: polygon(50% 0, 0 100%, 100% 100%);
+  }
+
   .how-we-work__bottom {
     margin-top: 24px;
   }
